# ==============================================================================
# Crossbridge AI - Environment Configuration (.env.example)
# Team ERROR (Lead: Chirantan Samuel Chetan, Ashish Singh)
# ==============================================================================

# Database (PostgreSQL)
# Local Docker Compose uses: postgresql://postgres:postgres@postgres:5432/crossbridge
# Local bare-metal uses: postgresql://postgres:postgres@localhost:5432/crossbridge
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crossbridge

# Backend Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# AI Fraud & Optimization Microservice
AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# PayPal Developer Sandbox Configuration
# Obtain test credentials from: https://developer.paypal.com/dashboard/applications/sandbox
# 
# IMPORTANT:
# - Leave blank to run Crossbridge in "Simulated Demo Funding" mode (clearly labeled in UI).
# - When populated, Crossbridge calls real PayPal Sandbox Orders v2 API server-side.
# - NEVER commit real credentials to GitHub.
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Frontend Client
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
